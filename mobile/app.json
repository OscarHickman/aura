{
  "expo": {
    "name": "AURA",
    "slug": "aura-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "aura",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oscarhickman.aura"
    },
    "android": {
      "package": "com.oscarhickman.aura",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
